+## Livox SDK is an explicit, pinned dependency. Never download or delete it
+## during a catkin configure step.
+set(LIVOX_SDK_ROOT "${LIVOX_SDK_ROOT}" CACHE PATH
+	"Pinned Livox-SDK checkout; default is the vendored driver dependency")
+if(NOT LIVOX_SDK_ROOT)
+	set(LIVOX_SDK_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/Livox-SDK")
+endif()
+find_library(LIVOX_SDK_LIBRARY NAMES livox_sdk_static
+	PATHS /usr/local/lib "${LIVOX_SDK_ROOT}/build/sdk_core" NO_DEFAULT_PATH)
+if((NOT LIVOX_SDK_LIBRARY) OR (NOT EXISTS "${LIVOX_SDK_ROOT}/sdk_core/include"))
+	message(FATAL_ERROR
+		"Livox-SDK is missing or not built. Prepare pinned checkout "
+		"https://github.com/Livox-SDK/Livox-SDK.git, build sdk_core, and "
+		"set LIVOX_SDK_ROOT; automatic download is disabled.")
+endif()
+message(STATUS "Using pinned Livox-SDK: ${LIVOX_SDK_ROOT}")
+include_directories(
+		../../devel/include
+		./
+		${LIVOX_SDK_ROOT}/sdk_core/include
+)
+link_directories(
+	./
+	${LIVOX_SDK_ROOT}/build/sdk_core
