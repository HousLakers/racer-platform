+void FastExplorationManager::noteLowSpeedEscapeRequest(const std_msgs::String::ConstPtr& msg) {
+  if (!(planner_escape_shadow_ || planner_escape_enabled_)) return;
+  if (planner_escape_trigger_mode_ != "low_speed_escape") {
+    ROS_WARN_STREAM("T1S4R low_speed_escape ignored mode=" << planner_escape_trigger_mode_);
+    return;
+  }
+  const ros::Time now = ros::Time::now();
+  const double startup_age = idle_origin_set_ ? (now - idle_origin_).toSec() : 0.0;
+  if (planner_escape_startup_guard_sec_ > 0.0 && idle_origin_set_ &&
+      startup_age < planner_escape_startup_guard_sec_) {
+    ROS_WARN_STREAM("T1S4R low_speed_escape startup_guard age=" << startup_age
+                    << " guard=" << planner_escape_startup_guard_sec_);
+    return;
+  }
+  auto extract_number = [&msg](const std::string& key, double& out) -> bool {
+    const std::string needle = "\"" + key + "\":";
+    const size_t pos0 = msg->data.find(needle);
+    if (pos0 == std::string::npos) return false;
+    const char* begin = msg->data.c_str() + pos0 + needle.size();
+    char* end = nullptr;
+    const double val = std::strtod(begin, &end);
+    if (end == begin) return false;
+    out = val;
+    return true;
+  };
+  double x = 0.0, y = 0.0, z = 0.0, action_id = 0.0, urgent_retrigger = 0.0;
+  const bool has_pos = extract_number("x", x) && extract_number("y", y) && extract_number("z", z);
+  if (has_pos) low_speed_escape_request_pos_ = Eigen::Vector3d(x, y, z);
+  else low_speed_escape_request_pos_ = planner_last_fail_pos_;
+  if (!low_speed_escape_request_pos_.allFinite() ||
+      low_speed_escape_request_pos_.head<2>().norm() < 1e-6) {
+    low_speed_escape_request_pos_ = ed_->next_pos_;
+  }
+  if (extract_number("action_id", action_id)) {
+    low_speed_escape_request_id_ = static_cast<int>(std::llround(action_id));
+  } else {
+    ++low_speed_escape_request_id_;
+  }
+  low_speed_escape_urgent_ =
+      extract_number("urgent_retrigger", urgent_retrigger) && urgent_retrigger > 0.5;
+  low_speed_escape_request_time_ = now;
+  planner_last_candidate_time_ = now;
+  planner_last_fail_pos_ = low_speed_escape_request_pos_;
+  shadow_candidate_active_ = true;
+  low_speed_escape_requested_ = true;
+  ++planner_shadow_candidate_count_;
+  ROS_WARN_STREAM("T1S4R low_speed_escape request action_id=" << low_speed_escape_request_id_
+                  << " urgent=" << low_speed_escape_urgent_
+                  << " pos=" << low_speed_escape_request_pos_.transpose());
+  maybeArmFusionEscape();
+}
+
+void FastExplorationManager::maybeArmFusionEscape() {
+  if (!(planner_escape_shadow_ || planner_escape_enabled_)) return;
+  if (fusion_escape_armed_) return;
+  const ros::Time now = ros::Time::now();
+  const double startup_age = idle_origin_set_ ? (now - idle_origin_).toSec() : 0.0;
+  if (planner_escape_trigger_mode_ == "candidate_direct") {
+    if (!shadow_candidate_active_) return;
+    if (planner_escape_startup_guard_sec_ > 0.0 && idle_origin_set_ &&
+        startup_age < planner_escape_startup_guard_sec_) {
+      ROS_WARN_STREAM("T1S4R candidate_startup_guard age=" << startup_age
+                      << " guard=" << planner_escape_startup_guard_sec_);
+      return;
+    }
+  } else if (planner_escape_trigger_mode_ == "cluster_fsm") {
+    if (fsm_recovery_triggers_ < 1) return;
+    if (!planner_escape_idle_enabled_ ||
+        idle_net_ < planner_escape_idle_net_threshold_) {
+      ROS_WARN_STREAM("T1S4R cluster_fsm_not_ready idle_net=" << idle_net_
+                      << " threshold=" << planner_escape_idle_net_threshold_);
+      return;
+    }
+  } else if (planner_escape_trigger_mode_ == "low_speed_escape") {
+    if (!low_speed_escape_requested_) return;
+  } else {
+    if (!shadow_candidate_active_ || fsm_recovery_triggers_ < 1) return;
+    if (planner_escape_idle_enabled_ &&
+        idle_net_ < planner_escape_idle_net_threshold_) return;
+    const double age = (now - planner_last_candidate_time_).toSec();
+    if (fusion_match_mode_ == "fresh_overlap" && age > fusion_match_window_sec_) {
+      ROS_WARN_STREAM("T1S4R fusion_candidate_stale age=" << age
+                      << " window=" << fusion_match_window_sec_);
+      return;
+    }
+  }
+  fusion_escape_armed_ = true;
+  ROS_WARN_STREAM("T1S4R fusion_armed mode=" << planner_escape_trigger_mode_
+                  << " fsm_triggers=" << fsm_recovery_triggers_
+                  << " shadow_candidates=" << planner_shadow_candidate_count_
+                  << " idle_net=" << idle_net_);
+}
+
+void FastExplorationManager::updatePlannerShadowState(const std::string& viewpoint) {
+  if (!(planner_escape_shadow_ || planner_escape_enabled_)) return;
+  if (!viewpoint.empty()) {
+    planner_recent_views_.push_back(viewpoint);
+    while (planner_recent_views_.size() > 40) planner_recent_views_.pop_front();
+  }
+  double repeat_fraction = 0.0;
+  if (!planner_recent_views_.empty()) {
+    std::map<std::string, int> counts;
+    for (const auto& view : planner_recent_views_) counts[view] += 1;
+    int best = 0;
+    for (const auto& item : counts) best = std::max(best, item.second);
+    repeat_fraction = double(best) / double(planner_recent_views_.size());
+  }
+  const int effective_fail_count =
+      std::max(planner_consecutive_failures_, planner_fail_window_count_);
+  const bool fail_streak = effective_fail_count >= planner_escape_fail_threshold_;
+  const bool repeat_hit = repeat_fraction >= planner_escape_repeat_threshold_;
+  if (!(fail_streak || repeat_hit)) return;
+  if (shadow_candidate_active_) {
+    ROS_WARN_STREAM("T1S4R planner_shadow candidate_latched mode="
+                    << planner_escape_trigger_mode_);
+    return;
+  }
+  planner_shadow_candidate_count_ += 1;
+  shadow_candidate_active_ = true;
+  planner_last_candidate_time_ = ros::Time::now();
+  ROS_WARN_STREAM(
+      "T1S4R planner_shadow candidate streak=" << planner_consecutive_failures_
+      << " fail_window=" << planner_fail_window_count_
+      << " effective=" << effective_fail_count
+      << " repeat=" << repeat_fraction << " fail_streak=" << fail_streak
+      << " repeat_hit=" << repeat_hit);
+  maybeArmFusionEscape();
+}
+
+void FastExplorationManager::notePlannerPlanFail(const std::string& kind) {
+  if (!(planner_escape_shadow_ || planner_escape_enabled_)) return;
+  const ros::Time now = ros::Time::now();
+  if (planner_escape_v2_sticky_center_ && kind == "plan_fail" &&
+      !planner_last_detailed_fail_time_.isZero() &&
+      (now - planner_last_detailed_fail_time_).toSec() < 0.25) {
+    ROS_INFO("T1S4R planner_fail deduplicated_generic");
+    return;
+  }
+  if (kind != "plan_fail") planner_last_detailed_fail_time_ = now;
+  planner_consecutive_failures_ += 1;
+  planner_fail_events_.push_back(now);
+  const double win = std::max(0.1, planner_escape_fail_window_sec_);
+  while (!planner_fail_events_.empty() &&
+      (now - planner_fail_events_.front()).toSec() > win) {
+    planner_fail_events_.pop_front();
+  }
+  planner_fail_window_count_ = static_cast<int>(planner_fail_events_.size());
+  planner_last_fail_pos_ = ed_->next_pos_;
+  const int effective_fail_count =
+      std::max(planner_consecutive_failures_, planner_fail_window_count_);
+  ROS_WARN_STREAM("T1S4R planner_fail_window kind=" << kind
+                  << " consecutive=" << planner_consecutive_failures_
+                  << " window_count=" << planner_fail_window_count_
+                  << " window_sec=" << planner_escape_fail_window_sec_
+                  << " effective=" << effective_fail_count);
+  const double startup_age = idle_origin_set_ ? (now - idle_origin_).toSec() : 0.0;
+  const bool v2_startup_ready = !idle_origin_set_ ||
+      planner_escape_startup_guard_sec_ <= 0.0 ||
+      startup_age >= planner_escape_startup_guard_sec_;
+  if (planner_escape_v2_enabled_ && planner_escape_v2_trigger_on_planner_fail_ &&
+      v2_startup_ready && effective_fail_count >= planner_escape_fail_threshold_) {
+    const bool episode_was_active = planner_escape_v2_active_;
+    const bool preserve_episode = episode_was_active && planner_escape_v2_sticky_center_;
+    if (!preserve_episode) {
+      planner_escape_v2_active_ = true;
+      planner_escape_v2_center_ =
+          planner_escape_v2_sticky_center_ && planner_last_fail_origin_valid_ ?
+          planner_last_fail_origin_ : planner_last_fail_pos_;
+      planner_escape_v2_until_ = now + ros::Duration(planner_escape_v2_ttl_sec_);
+      if (!episode_was_active) planner_escape_v2_failed_targets_.clear();
+    } else {
+      ROS_INFO_STREAM("T1S4R v2_escape preserve_episode center="
+                      << planner_escape_v2_center_.transpose());
+    }
+    ROS_WARN_STREAM("T1S4R v2_escape armed_by_planner_fail kind=" << kind
+                    << " center=" << planner_escape_v2_center_.transpose()
+                    << " fail_streak=" << planner_consecutive_failures_
+                    << " fail_window=" << planner_fail_window_count_
+                    << " startup_age=" << startup_age);
+  }
+  updatePlannerShadowState(kind);
+  maybeArmFusionEscape();
+}
+
+void FastExplorationManager::maybeApplyPlannerEscape(vector<int>& ftr_ids, const Vector3d& cur_pos) {
+  if (!fusion_escape_armed_) return;
+  if (!planner_escape_enabled_ || !planner_escape_fusion_enabled_) return;
+  if (planner_escape_count_ >= planner_escape_max_count_) return;
+  const double cooldown = (ros::Time::now() - planner_escape_last_time_).toSec();
+  const double required_cooldown =
+      low_speed_escape_urgent_ ? planner_escape_urgent_cooldown_sec_ : planner_escape_cooldown_sec_;
+  if (cooldown < required_cooldown) return;
+  if (!fusionCollisionGuardOk()) {
+    ROS_WARN("T1S4R fusion_execute blocked collision_guard");
+    return;
+  }
+  if (ftr_ids.empty()) return;
+  planner_suppressed_center_ =
+      planner_escape_trigger_mode_ == "cluster_fsm" ? fsm_last_trigger_pos_ :
+      planner_escape_trigger_mode_ == "low_speed_escape" ? low_speed_escape_request_pos_ :
+      planner_last_fail_pos_;
+  if (!planner_suppressed_center_.allFinite() ||
+      planner_suppressed_center_.head<2>().norm() < 1e-6) {
+    planner_suppressed_center_ = cur_pos;
+  }
+  planner_suppress_until_ = ros::Time::now() + ros::Duration(planner_escape_suppress_sec_);
+  if (failure_memory_enabled_ && planner_escape_trigger_mode_ == "low_speed_escape") {
+    recordViewpointFailure(cur_pos, planner_suppressed_center_, "low_speed_escape");
+  }
+  planner_escape_count_ += 1;
+  planner_escape_last_time_ = ros::Time::now();
+  if (planner_escape_v2_enabled_) {
+    const ros::Time v2_now = ros::Time::now();
+    const bool preserve_episode = planner_escape_v2_active_ &&
+        v2_now <= planner_escape_v2_until_ && planner_escape_v2_sticky_center_;
+    planner_escape_v2_active_ = true;
+    if (!preserve_episode) {
+      planner_escape_v2_center_ = planner_suppressed_center_;
+      planner_escape_v2_failed_targets_.clear();
+    }
+    planner_escape_v2_until_ = v2_now + ros::Duration(planner_escape_v2_ttl_sec_);
+    ROS_WARN_STREAM("LE8G v2_escape low_speed_episode center="
+                    << planner_escape_v2_center_.transpose()
+                    << " preserve=" << preserve_episode
+                    << " failed_targets=" << planner_escape_v2_failed_targets_.size()
+                    << " until=" << planner_escape_v2_until_.toSec());
+  }
+  fusion_escape_armed_ = false;
+  low_speed_escape_requested_ = false;
+  low_speed_escape_urgent_ = false;
+  planner_consecutive_failures_ = 0;
+  planner_fail_window_count_ = 0;
+  planner_fail_events_.clear();
+  ROS_WARN_STREAM("T1S4R fusion_execute mode=" << planner_escape_trigger_mode_
+                  << " suppress_center=" << planner_suppressed_center_.transpose()
+                  << " cooldown=" << cooldown
+                  << " required_cooldown=" << required_cooldown
+                  << " escape_count=" << planner_escape_count_);
+  vector<int> kept;
+  kept.reserve(ftr_ids.size());
+  for (const int id : ftr_ids) {
+    if (id < 0 || id >= static_cast<int>(ed_->points_.size())) continue;
+    const auto& pt = ed_->points_[id];
+    const double d_sup = (pt.head<2>() - planner_suppressed_center_.head<2>()).norm();
+    if (d_sup <= planner_escape_cluster_radius_m_) {
+      ROS_WARN_STREAM("T1S4R planner_escape suppress frontier=" << id << " d=" << d_sup);
+      continue;
+    }
+    kept.push_back(id);
+  }
+  if (!kept.empty()) ftr_ids.swap(kept);
+  shadow_candidate_active_ = false;
+  if (planner_escape_trigger_mode_ != "legacy" &&
+      planner_escape_trigger_mode_ != "fresh_overlap") resetIdleWindow();
+  ROS_WARN_STREAM("T1S4R planner_escape topology_bonus=" << planner_escape_topology_bonus_
+                  << " kept_frontiers=" << ftr_ids.size());
+}
+
+void FastExplorationManager::refreshFailureMemory() {
+  if (!failure_memory_enabled_) return;
+  const double now = ros::Time::now().toSec();
+  for (auto& region : failure_regions_) {
+    if (!region.release_logged && now >= region.blocked_until) {
+      ROS_INFO("S3F released_failure x=%.3f y=%.3f z=%.3f failures=%d", region.center.x(),
+          region.center.y(), region.center.z(), region.failure_count);
+      region.release_logged = true;
+    }
+  }
+  failure_regions_.erase(
+      std::remove_if(failure_regions_.begin(), failure_regions_.end(),
+          [this, now](const FailureRegion& region) {
+            return now - region.last_failure_time > failure_forget_sec_;
+          }),
+      failure_regions_.end());
+}
+
+void FastExplorationManager::recordViewpointFailure(
+    const Vector3d& from, const Vector3d& pos, const std::string& reason) {
+  if (reason != "low_speed_escape") {
+    planner_last_fail_origin_ = from;
+    planner_last_fail_origin_valid_ = from.allFinite();
+  }
+  if (planner_escape_v2_failed_target_memory_ && planner_escape_v2_active_ &&
+      planner_escape_v2_goal_overridden_ &&
+      (planner_escape_v2_goal_.head<2>() - pos.head<2>()).norm() <= 0.25) {
+    const double expiry = ros::Time::now().toSec() + planner_escape_v2_memory_ttl_sec_;
+    bool updated = false;
+    for (auto& item : planner_escape_v2_failed_targets_) {
+      if ((item.first.head<2>() - pos.head<2>()).norm() <=
+          planner_escape_v2_failed_target_radius_m_) {
+        item = {pos, expiry};
+        updated = true;
+        break;
+      }
+    }
+    if (!updated) planner_escape_v2_failed_targets_.push_back({pos, expiry});
+    if (planner_escape_v2_failed_targets_.size() > 16)
+      planner_escape_v2_failed_targets_.erase(planner_escape_v2_failed_targets_.begin());
+    ROS_WARN_STREAM("T1S4R v2_escape failed_target_record reason=" << reason
+                    << " target=" << pos.transpose()
+                    << " count=" << planner_escape_v2_failed_targets_.size());
+    planner_escape_v2_goal_overridden_ = false;
+  }
+  if (!failure_memory_enabled_) return;  // LE8G v2 memory is independent.
+  if (reason == "postplan_unsafe") {
+    // Keep the short-lived per-episode failed target above, but do not turn a
+    // safety-check rejection into a 120 s global frontier blacklist.
+    ROS_INFO_STREAM("LE8E postplan_guard local_memory_only target=" << pos.transpose());
+    return;
+  }
+  Vector3d approach = pos - from;
+  approach.z() = 0.0;
+  if (approach.norm() > 1e-3)
+    approach.normalize();
+  else
+    approach.setZero();
+  const double now = ros::Time::now().toSec();
+  FailureRegion* matched = nullptr;
+  double best_distance = failure_region_size_m_;
+  for (auto& region : failure_regions_) {
+    const double distance = (region.center.head<2>() - pos.head<2>()).norm();
+    const bool same_reason = region.reason == reason;
+    const bool same_approach = region.approach.norm() < 1e-3 || approach.norm() < 1e-3 ||
+        region.approach.dot(approach) >= failure_approach_cos_;
+    if (same_reason && same_approach && distance <= best_distance) {
+      best_distance = distance;
+      matched = &region;
+    }
+  }
+  if (matched == nullptr) {
+    failure_regions_.push_back(
+        { pos, approach, reason, 0, now, now, false, false });
+    matched = &failure_regions_.back();
+  }
+
+  matched->center = pos;
+  matched->approach = approach;
+  matched->reason = reason;
+  matched->failure_count += 1;
+  matched->last_failure_time = now;
+  matched->blacklisted = matched->failure_count >= failure_blacklist_threshold_;
+  matched->blocked_until =
+      now + (matched->blacklisted ? failure_blacklist_sec_ : failure_cooldown_sec_);
+  matched->release_logged = false;
+  ROS_WARN(
+      "S3F failure_memory_record type=%s x=%.3f y=%.3f z=%.3f failures=%d blacklisted=%d "
+      "blocked_until=%.3f enforce=%d",
+      reason.c_str(), pos.x(), pos.y(), pos.z(), matched->failure_count,
+      matched->blacklisted ? 1 : 0, matched->blocked_until, failure_memory_enforce_ ? 1 : 0);
+}
+
+double FastExplorationManager::failureMemoryPenalty(
+    const Vector3d& from, const Vector3d& pos, bool* blacklisted, bool shadow) {
+  if (blacklisted != nullptr) *blacklisted = false;
+  if (!failure_memory_enabled_ || (!failure_memory_enforce_ && !shadow)) return 0.0;
+  const double now = ros::Time::now().toSec();
+  FailureRegion* matched = nullptr;
+  double best_distance = failure_region_size_m_;
+  Vector3d approach = pos - from;
+  approach.z() = 0.0;
+  if (approach.norm() > 1e-3)
+    approach.normalize();
+  else
+    approach.setZero();
+  for (auto& region : failure_regions_) {
+    if (now >= region.blocked_until) continue;
+    if (failure_memory_enforce_low_speed_only_ && !shadow &&
+        region.reason != "low_speed_escape" &&
+        region.reason != "postplan_global_unsafe") {
+      continue;
+    }
+    const double distance = (region.center.head<2>() - pos.head<2>()).norm();
+    const bool same_approach = region.approach.norm() < 1e-3 || approach.norm() < 1e-3 ||
+        region.approach.dot(approach) >= failure_approach_cos_;
+    if (same_approach && distance <= best_distance) {
+      best_distance = distance;
+      matched = &region;
+    }
+  }
+  if (matched == nullptr) return 0.0;
+  if (blacklisted != nullptr) *blacklisted = matched->blacklisted;
+  const double reason_scale =
+      matched->reason == "kinodynamic_replan" ? failure_kino_scale_ : 1.0;
+  return reason_scale * (matched->blacklisted ? 2.0 : 1.0);
+}
+
+double FastExplorationManager::failureMemoryPenalty(
+    const Vector3d& pos, bool* blacklisted) {
+  return failureMemoryPenalty(pos, pos, blacklisted);
+}
+
+bool FastExplorationManager::failureMemoryBlacklisted(const Vector3d& pos) {
+  bool blacklisted = false;
+  failureMemoryPenalty(pos, &blacklisted);
+  return blacklisted;
+}
+
+void FastExplorationManager::applyFailureMemoryCosts(
+    Eigen::MatrixXd& mat, const vector<int>& ftr_ids, int drone_num) {
+  if (!failure_memory_enabled_ || !failure_memory_enforce_) return;
+  if (!failure_memory_frontier_soft_enforce_) {
+    ROS_INFO("S3F frontier_penalty_disabled frontiers=%zu", ftr_ids.size());
+    return;
+  }
+  if (ftr_ids.size() < 2 || mat.rows() <= drone_num) {
+    ROS_INFO("S3F frontier_soft_summary frontiers=%zu applied=0 reason=insufficient", ftr_ids.size());
+    return;
+  }
+
+  vector<double> base_costs(ftr_ids.size(), 0.0);
+  vector<double> penalties(ftr_ids.size(), 0.0);
+  vector<double> finite_costs;
+  for (int i = 0; i < static_cast<int>(ftr_ids.size()); ++i) {
+    const int col = 1 + drone_num + i;  // LE8G memory true frontier column
+    if (col < mat.cols()) {
+      base_costs[i] = mat(drone_num, col);
+      if (std::isfinite(base_costs[i]) && base_costs[i] > 0.0 && base_costs[i] < 10000.0)
+        finite_costs.push_back(base_costs[i]);
+    }
+  }
+  double cost_median = 0.0;
+  if (!finite_costs.empty()) {
+    const size_t mid = finite_costs.size() / 2;
+    std::nth_element(finite_costs.begin(), finite_costs.begin() + mid, finite_costs.end());
+    cost_median = finite_costs[mid];
+  }
+
+  int matched = 0;
+  double max_ratio = 0.0;
+  for (int i = 0; i < static_cast<int>(ftr_ids.size()); ++i) {
+    const int id = ftr_ids[i];
+    if (id < 0 || id >= static_cast<int>(ed_->points_.size())) continue;
+    const Vector3d& point = ed_->points_[id];
+    const double multiplier = failureMemoryPenalty(point);
+    const double clearance = sdf_map_->getDistance(point);
+    const double protect =
+        clearance < failure_clearance_protect_m_ ? failure_protected_scale_ : 1.0;
+    if (multiplier > 0.0 && std::isfinite(base_costs[i]) &&
+        base_costs[i] > 0.0 && cost_median > 0.0) {
+      penalties[i] = std::min(failure_frontier_penalty_ratio_ * base_costs[i],
+          failure_cost_penalty_ * cost_median * multiplier * protect);
+      if (penalties[i] > 0.0) {
+        ++matched;
+        max_ratio = std::max(max_ratio, penalties[i] / std::max(base_costs[i], 1e-3));
+      }
+    }
+  }
+
+  const double fraction = ftr_ids.empty() ? 0.0 :
+      static_cast<double>(matched) / static_cast<double>(ftr_ids.size());
+  const bool guarded = matched > 0 && matched < static_cast<int>(ftr_ids.size()) &&
+      fraction <= failure_frontier_max_fraction_;
+  if (guarded) {
+    for (int i = 0; i < static_cast<int>(ftr_ids.size()); ++i) {
+      const int col = 1 + drone_num + i;
+      if (penalties[i] <= 0.0 || col >= mat.cols()) continue;
+      for (int row = 0; row < mat.rows(); ++row) {
+        if (row == col) continue;
+        mat(row, col) += penalties[i];
+      }
+    }
+  }
+  ROS_INFO(
+      "S3F frontier_soft_summary frontiers=%zu matched=%d fraction=%.3f guarded=%d "
+      "applied=%d median=%.3f max_ratio=%.3f max_fraction=%.3f",
+      ftr_ids.size(), matched, fraction, guarded ? 1 : 0, guarded ? 1 : 0,
+      cost_median, max_ratio, failure_frontier_max_fraction_);
+}
