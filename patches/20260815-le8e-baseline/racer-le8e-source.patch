+void FastExplorationManager::publishTargetContext(const Vector3d& cur_pos,
+    const Vector3d& cur_vel, const Vector3d& target_pos, double target_yaw,
+    int selected_target_id, const vector<int>& candidate_ids) {
+  if (!target_context_pub_) return;
+  unsigned long long candidate_hash = 1469598103934665603ULL;
+  for (const int id : candidate_ids) {
+    candidate_hash ^= static_cast<unsigned long long>(id + 1000003);
+    candidate_hash *= 1099511628211ULL;
+  }
+  unsigned long long cluster_id = 0;
+  if (selected_target_id >= 0 &&
+      selected_target_id < static_cast<int>(ed_->frontiers_.size())) {
+    const auto& cells = ed_->frontiers_[selected_target_id];
+    cluster_id = 1469598103934665603ULL ^ static_cast<unsigned long long>(cells.size());
+    for (const auto& cell : cells) {
+      const long long qx = static_cast<long long>(std::llround(cell.x() * 100.0));
+      const long long qy = static_cast<long long>(std::llround(cell.y() * 100.0));
+      const long long qz = static_cast<long long>(std::llround(cell.z() * 100.0));
+      unsigned long long cell_hash = static_cast<unsigned long long>(qx + 1000003);
+      cell_hash = (cell_hash * 1099511628211ULL) ^ static_cast<unsigned long long>(qy + 1000003);
+      cell_hash = (cell_hash * 1099511628211ULL) ^ static_cast<unsigned long long>(qz + 1000003);
+      // XOR aggregation makes the identity independent of the frontier-cell
+      // traversal order while retaining the quantized cluster geometry.
+      cluster_id ^= cell_hash;
+    }
+  }
+  if (!context_state_initialized_ ||
+      selected_target_id != last_context_target_id_ ||
+      cluster_id != last_context_cluster_id_) {
+    if (selected_target_id >= 0 && target_repeat_counts_.count(selected_target_id)) {
+      ++target_repeat_counts_[selected_target_id];
+    } else if (selected_target_id >= 0) {
+      target_repeat_counts_[selected_target_id] = 0;
+    }
+    ++target_context_episode_id_;
+    last_context_target_id_ = selected_target_id;
+    last_context_cluster_id_ = cluster_id;
+    context_state_initialized_ = true;
+  }
+  const double distance = (target_pos - cur_pos).norm();
+  const double speed = cur_vel.norm();
+  const double remaining = speed > 0.05 ? distance / speed
+                                         : std::numeric_limits<double>::quiet_NaN();
+  double coverage_gain = std::numeric_limits<double>::quiet_NaN();
+  if (selected_target_id >= 0) {
+    coverage_gain = static_cast<double>(frontier_finder_->computeGainOfView(target_pos, target_yaw));
+  }
+  const double freshness = (ros::Time::now() - last_frontier_context_time_).toSec();
+  const int repeat = selected_target_id >= 0 ? target_repeat_counts_[selected_target_id] : 0;
+  std::ostringstream out;
+  out << "{\"sim_time\":" << ros::Time::now().toSec()
+      << ",\"selected_target_id\":" << selected_target_id
+      << ",\"target_distance\":" << distance
+      << ",\"target_freshness\":" << freshness
+      << ",\"target_remaining_time\":";
+  if (std::isfinite(remaining)) out << remaining;
+  else out << "null";
+  out
+      << ",\"candidate_set_hash\":\"" << candidate_hash << "\""
+      << ",\"candidate_set_ids\":[";
+  for (size_t i = 0; i < candidate_ids.size(); ++i) {
+    if (i) out << ",";
+    out << candidate_ids[i];
+  }
+  out << "]"
+      << ",\"frontier_cluster_id\":" << cluster_id
+      << ",\"target_repeat_count\":" << repeat
+      << ",\"cluster_traj_episode_id\":\"" << target_context_episode_id_ << "\""
+      << ",\"coverage_gain\":";
+  if (std::isfinite(coverage_gain)) out << coverage_gain;
+  else out << "null";
+  out << "}";
+  std_msgs::String msg;
+  msg.data = out.str();
+  target_context_pub_.publish(msg);
+}
