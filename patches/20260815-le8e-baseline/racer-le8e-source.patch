+void FastExplorationManager::noteIdleReplan(int sign) {
+  ros::Time now = ros::Time::now();
+  if (!idle_origin_set_) {
+    idle_origin_ = now;
+    idle_origin_set_ = true;
+  }
+  if (planner_escape_idle_skip_sec_ > 0.0 && (now - idle_origin_).toSec() < planner_escape_idle_skip_sec_) {
+    return;  // skip startup noise
+  }
+  idle_events_.push_back({now, sign});
+  idle_net_ += sign;
+  const double win = planner_escape_idle_window_sec_;
+  while (!idle_events_.empty() && (now - idle_events_.front().first).toSec() > win) {
+    idle_net_ -= idle_events_.front().second;
+    idle_events_.pop_front();
+  }
+  if (idle_net_ < 0) idle_net_ = 0;
+}
+
+void FastExplorationManager::resetIdleWindow() {
+  idle_events_.clear();
+  idle_net_ = 0;
+}
