diff --git a/swarm_lio/scripts/px4_bridge.py b/swarm_lio/scripts/px4_bridge.py
new file mode 100755
index 0000000..13c559f
--- /dev/null
+++ b/swarm_lio/scripts/px4_bridge.py
@@ -0,0 +1,189 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+PX4 Bridge: RACER PositionCommand <-> PX4 SITL via MAVROS
+针对 RACER 多机协同探索架构优化（集成 2Hz 持续坐标偏移广播与双向映射）
+"""
+
+import rospy
+import threading
+import math
+from geometry_msgs.msg import Point, PoseStamped
+from mavros_msgs.msg import PositionTarget, State
+from mavros_msgs.srv import SetMode, CommandBool
+from nav_msgs.msg import Odometry
+from quadrotor_msgs.msg import PositionCommand
+
+connected = False
+current_state = State()
+latest_cmd = None
+cmd_lock = threading.Lock()
+
+def state_cb(msg):
+    global connected, current_state
+    current_state = msg
+    connected = msg.connected
+
+def cmd_cb(msg):
+    global latest_cmd
+    with cmd_lock:
+        latest_cmd = msg
+
+def main():
+    global connected, latest_cmd
+
+    rospy.init_node("px4_bridge_node", anonymous=True)
+    
+    drone_id = rospy.get_param("~drone_id", 1)
+    ns = rospy.get_param("~mavros_ns", "")
+    init_pos = rospy.get_param("~init_pos", [0.0, 0.0])  # 物理出发偏移 [x_offset, y_offset]
+    
+    # 中继话题设置，彻底防止与 Swarm-LIO 的 /lidar_slam/odom_N 发生总线冲突！
+    odom_out_topic = rospy.get_param("~odom_topic", f"/mavros_relay/odom_{drone_id}")
+
+    rospy.loginfo(f"[Bridge {drone_id}] 启动中，绑定 MAVROS: '{ns}' | 物理全局偏移: {init_pos}")
+
+    # 1. 2Hz 后台定时器，向 RACER 注入物理起飞坐标偏移（彻底解决地图叠加与防撞锁死）
+    init_pub = rospy.Publisher("/pcl_render_node/init", Point, queue_size=10)
+    init_msg = Point(x=float(init_pos[0]), y=float(init_pos[1]), z=float(drone_id))
+    rospy.Timer(rospy.Duration(0.5), lambda e: init_pub.publish(init_msg))
+    rospy.loginfo(f"[Bridge {drone_id}] 后台 2Hz 坐标偏移发射器已启动，持续注入集群网络")
+
+    # 2. 定义发布器
+    setpoint_pub = rospy.Publisher(f"{ns}/mavros/setpoint_raw/local", PositionTarget, queue_size=10)
+    odom_pub = rospy.Publisher(odom_out_topic, Odometry, queue_size=10)
+    gt_pose_pub = rospy.Publisher(f"/mavros_relay/pose_{drone_id}", PoseStamped, queue_size=10)
+
+    # 3. 里程计中继与坐标转译（注意：绝不在此发布动态 TF，避免与 Swarm-LIO 打架）
+    def odom_cb(msg):
+        # 加上全局物理起飞偏移后发布中继里程计
+        msg.pose.pose.position.x += float(init_pos[0])
+        msg.pose.pose.position.y += float(init_pos[1])
+        odom_pub.publish(msg)
+        
+        # 提取转为 PoseStamped
+        pose_msg = PoseStamped()
+        pose_msg.header = msg.header
+        pose_msg.pose = msg.pose.pose
+        gt_pose_pub.publish(pose_msg)
+
+    rospy.Subscriber(f"{ns}/mavros/local_position/odom", Odometry, odom_cb)
+    rospy.Subscriber(f"{ns}/mavros/state", State, state_cb)
+    rospy.Subscriber(f"/planning/pos_cmd_{drone_id}", PositionCommand, cmd_cb)
+
+    # 4. 等待飞控心跳
+    rospy.loginfo(f"[Bridge {drone_id}] 等待飞控连接...")
+    rate = rospy.Rate(20)
+    while not connected and not rospy.is_shutdown():
+        rate.sleep()
+    rospy.loginfo(f"[Bridge {drone_id}] 心跳已接通！")
+
+    HOVER_MASK = (PositionTarget.IGNORE_VX | PositionTarget.IGNORE_VY | PositionTarget.IGNORE_VZ |
+                  PositionTarget.IGNORE_AFX | PositionTarget.IGNORE_AFY | PositionTarget.IGNORE_AFZ |
+                  PositionTarget.IGNORE_YAW_RATE)
+    # Use position-only tracking. RACER's velocity feed-forward is in its
+    # world frame and becomes inconsistent with the MAVROS raw target after
+    # repeated replans; the PX4 position loop is safer for this SITL bridge.
+    TRAJ_MASK = (PositionTarget.IGNORE_VX | PositionTarget.IGNORE_VY |
+                 PositionTarget.IGNORE_VZ | PositionTarget.IGNORE_AFX |
+                 PositionTarget.IGNORE_AFY | PositionTarget.IGNORE_AFZ |
+                 PositionTarget.IGNORE_YAW_RATE)
+
+    # 5. 预热设定点 (局部坐标悬停于 0,0,1.5)
+    hover_target = PositionTarget()
+    hover_target.coordinate_frame = PositionTarget.FRAME_LOCAL_NED
+    hover_target.type_mask = HOVER_MASK
+    hover_target.position.x = 0.0
+    hover_target.position.y = 0.0
+    # This MAVROS/PX4 SITL adapter exposes the established RACER convention
+    # on the ROS raw-setpoint path: positive z is the commanded altitude.
+    hover_target.position.z = 1.5
+    hover_target.yaw = 0.0
+
+    rospy.loginfo(f"[Bridge {drone_id}] 开始向 PX4 预热悬停设定点...")
+    for _ in range(50):
+        hover_target.header.stamp = rospy.Time.now()
+        setpoint_pub.publish(hover_target)
+        rate.sleep()
+
+    # 6. 切 OFFBOARD 与解锁（修复：切模式期间必须持续发布 setpoint，防止 PX4 心跳超时拒切）
+    set_mode = rospy.ServiceProxy(f"{ns}/mavros/set_mode", SetMode)
+    arm = rospy.ServiceProxy(f"{ns}/mavros/cmd/arming", CommandBool)
+
+    rospy.loginfo(f"[Bridge {drone_id}] 正在请求 OFFBOARD 模式并解锁...")
+    for _ in range(30):
+        hover_target.header.stamp = rospy.Time.now()
+        setpoint_pub.publish(hover_target)
+        try:
+            if current_state.mode != "OFFBOARD":
+                set_mode(custom_mode="OFFBOARD")
+            if not current_state.armed:
+                arm(True)
+        except Exception:
+            pass
+        rate.sleep()
+
+    rospy.loginfo(f"[Bridge {drone_id}] 成功解锁并进入自导悬停！等待 RACER 规划指令...")
+
+    # 7. 主控制循环
+    loop_rate = rospy.Rate(50)
+    arm_fail_count = 0
+
+    while not rospy.is_shutdown():
+        # 安全守卫：掉解锁时自动补解锁与切 OFFBOARD
+        if not current_state.armed or current_state.mode != "OFFBOARD":
+            arm_fail_count += 1
+            if arm_fail_count % 50 == 0:
+                try:
+                    set_mode(custom_mode="OFFBOARD")
+                    arm(True)
+                except Exception:
+                    pass
+        else:
+            arm_fail_count = 0
+
+        target = PositionTarget()
+        target.header.stamp = rospy.Time.now()
+        target.coordinate_frame = PositionTarget.FRAME_LOCAL_NED
+
+        with cmd_lock:
+            cmd = latest_cmd
+
+        if cmd is not None:
+            target.type_mask = TRAJ_MASK
+            # 核心转化：RACER 全局轨迹 -> PX4 局部飞控轨迹（减去物理起飞偏移）
+            target.position.x = cmd.position.x - float(init_pos[0])
+            target.position.y = cmd.position.y - float(init_pos[1])
+            # Keep a conservative floor above the 3-D map ground plane.
+            target.position.z = max(cmd.position.z, 1.5)
+            
+            target.velocity.x = 0.0
+            target.velocity.y = 0.0
+            target.velocity.z = 0.0
+            target.yaw = cmd.yaw
+            target.yaw_rate = cmd.yaw_dot
+            # Keep a low-rate trace of the command actually forwarded to PX4.
+            # This distinguishes a planner that is replanning from a bridge or
+            # flight-mode path that is holding an old setpoint.
+            rospy.loginfo_throttle(
+                2.0,
+                "[Bridge %d] mode=%s armed=%s cmd=(%.3f, %.3f, %.3f) target=(%.3f, %.3f, %.3f)"
+                % (drone_id, current_state.mode, current_state.armed,
+                   cmd.position.x, cmd.position.y, cmd.position.z,
+                   target.position.x, target.position.y, target.position.z))
+        else:
+            target = hover_target
+            target.header.stamp = rospy.Time.now()
+            rospy.loginfo_throttle(
+                2.0,
+                "[Bridge %d] mode=%s armed=%s no planner command; holding hover"
+                % (drone_id, current_state.mode, current_state.armed))
+
+        setpoint_pub.publish(target)
+        loop_rate.sleep()
+
+if __name__ == "__main__":
+    try:
+        main()
+    except rospy.ROSInterruptException:
+        pass
